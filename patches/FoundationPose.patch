diff --git a/pyproject.toml b/pyproject.toml
new file mode 100644
index 0000000..e3e66aa
--- /dev/null
+++ b/pyproject.toml
@@ -0,0 +1,77 @@
+# Packaging shim so pkgs/FoundationPose can be installed as an editable
+# dependency inside a uv virtual environment (same pattern as pkgs/sam3).
+#
+# NOTE: this file is an addition local to v2s2a_pipeline; upstream
+# FoundationPose code is otherwise unmodified. The two real dependencies that
+# pip cannot express (nvdiffrast and pytorch3d, both compiled against the
+# installed torch/CUDA) must be built separately, e.g.:
+#
+#   pip install --no-build-isolation git+https://github.com/NVlabs/nvdiffrast.git
+#   pip install --no-build-isolation git+https://github.com/facebookresearch/pytorch3d.git
+#
+# and the mycpp extension is built in place (Utils.py adds mycpp/build to
+# sys.path automatically):
+#
+#   cd mycpp && mkdir -p build && cd build && cmake .. && make -j
+
+[build-system]
+requires = ["setuptools>=61", "wheel"]
+build-backend = "setuptools.build_meta"
+
+[project]
+name = "foundationpose"
+version = "0.1.0"
+description = "FoundationPose: unified 6D object pose estimation and tracking (NVlabs)"
+readme = "readme.md"
+requires-python = ">=3.10"
+license = {file = "LICENSE"}
+classifiers = [
+    "Development Status :: 4 - Beta",
+    "Intended Audience :: Science/Research",
+    "Programming Language :: Python :: 3",
+    "Topic :: Scientific/Engineering :: Artificial Intelligence",
+]
+dependencies = [
+    # Core numerics & IO (mirrors requirements.txt; torch/torchvision come
+    # from the parent project's CUDA-specific index, not from here)
+    "numpy>=1.26",
+    "scipy",
+    "scikit-learn",
+    "h5py",
+    "joblib",
+    "PyYAML>=6",
+    "ruamel.yaml>=0.18",
+    "opencv-python",
+    "imageio",
+    "open3d",
+    "trimesh",
+    "transformations",
+    "matplotlib",
+    "pandas",
+    "Pillow",
+    "pyrender",
+    "pyOpenGL>=3.1",
+    "pyOpenGL_accelerate>=3.1",
+    "kornia>=0.7",
+    "omegaconf>=2.3",
+    "psutil",
+    "tqdm",
+    "warp-lang",
+    "scikit-image",
+]
+
+[tool.setuptools]
+# The upstream repo is a flat script tree (estimater.py, Utils.py, ...) plus
+# the learning/ package; install it as one top-level package so
+# `from estimater import FoundationPose` keeps working.
+py-modules = [
+    "Utils",
+    "datareader",
+    "estimater",
+    "offscreen_renderer",
+]
+packages = ["learning", "learning.datasets", "learning.models", "learning.training"]
+
+# learning/ has no __init__.py upstream; setuptools needs them to treat it as
+# a package. These empty files are build-time only additions (gitignored via
+# learning/**/__init__.py in .gitignore is NOT added — they stay local).
